// Probes parallel-tensor inventory: quantities and prices advance in
// lockstep through one loop, the idiom arrays would replace.
let qty: Tensor = tensor_fill(4, 2.0);
let price: Tensor = tensor_fill(4, 1.5);
let line: Tensor = qty + price;
let total: Float = tensor_sum(line);
assert(total == 14.0);
print(total);
total;
